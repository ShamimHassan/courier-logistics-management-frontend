# ==========================================================
# CourierFlow Frontend — Environment Variables (Example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is listed in .gitignore
# ==========================================================

# ── Backend API ───────────────────────────────────────────
# Backend API base URL (must end with /api/v1)
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Production (Vercel):
# NEXT_PUBLIC_API_BASE_URL=https://courier-logistics-management-backend.vercel.app/api/v1

# ── Frontend URL ──────────────────────────────────────────
# Public URL of this frontend — used in meta tags and redirects
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel):
# NEXT_PUBLIC_APP_URL=https://courier-logistics-management-frontend-kgr6sjohc.vercel.app

# ── Authentication ────────────────────────────────────────
# Secret used to sign the HMAC middleware auth cookie.
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret-string-min-32-chars

# ── Payment Mode ──────────────────────────────────────────
# SSLCommerz mode — "sandbox" for testing, "production" for live
NEXT_PUBLIC_SSLCOMMERZ_MODE=sandbox

# ── Demo / Development Flags ──────────────────────────────
# Show one-click demo login buttons on the login page
# Set to "true" for demos and development, "false" for production
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true
