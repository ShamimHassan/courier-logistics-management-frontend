# ==========================================================
# CourierFlow Frontend — Environment Variables (Template)
# Copy this file to `.env.local` and fill in values.
# NEVER commit `.env.local` — it's ignored in .gitignore.
# ==========================================================

# ── Required ──────────────────────────────────────────────
# Backend API base URL (must end with /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Public URL of this frontend — used in meta tags, emails, redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────
# Secret used to sign the middleware auth cookie.
# Generate with:  openssl rand -hex 32
AUTH_COOKIE_SECRET=replace-with-64-char-hex-random-string

# ── Payment Mode (displayed in UI only) ───────────────────
# Use "sandbox" for SSLCommerz Sandbox, "production" for live
NEXT_PUBLIC_SSLCOMMERZ_MODE=sandbox
